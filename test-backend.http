### Backend API Test Requests
### Base URL: http://localhost:5000

# ============================================
# APP ENDPOINTS
# ============================================

### Health Check - GET /
# Returns a simple hello message to verify the API is running
GET http://localhost:5000/
Accept: application/json

###

# ============================================
# AUTH ENDPOINTS
# ============================================

### Register User - POST /auth/register
# Register a new user account with valid credentials
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "John Doe",
  "email": "john.doe@example.com",
  "password": "Password1!"
}

###

### Register User - Missing Full Name (should fail validation)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password1!"
}

###

### Register User - Invalid Email Format (should fail validation)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "invalid-email",
  "password": "Password1!"
}

###

### Register User - Password Missing Uppercase (should fail validation)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "test2@example.com",
  "password": "password1!"
}

###

### Register User - Password Missing Lowercase (should fail validation)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "test3@example.com",
  "password": "PASSWORD1!"
}

###

### Register User - Password Missing Number (should fail validation)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "test4@example.com",
  "password": "Password!"
}

###

### Register User - Password Missing Special Character (should fail validation)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "test5@example.com",
  "password": "Password1"
}

###

### Register User - Password Too Short (should fail validation)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "test6@example.com",
  "password": "Pa1!"
}

###

### Register User - Password Too Long (should fail validation)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "test7@example.com",
  "password": "Password1!TooLong"
}

###

### Register User - Duplicate Email (should fail - run after first successful register)
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Jane Doe",
  "email": "john.doe@example.com",
  "password": "Password2!"
}

###

### Register Second User - For Testing Multiple Users
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "fullName": "Jane Smith",
  "email": "jane.smith@example.com",
  "password": "SecurePass1!"
}

###

### Login User - POST /auth/login
# Authenticate with valid credentials
POST http://localhost:5000/auth/login
Content-Type: application/json

{
  "email": "john.doe@example.com",
  "password": "Password1!"
}

###

### Login User - Wrong Password (should fail)
POST http://localhost:5000/auth/login
Content-Type: application/json

{
  "email": "john.doe@example.com",
  "password": "WrongPassword1!"
}

###

### Login User - Non-existent Email (should fail)
POST http://localhost:5000/auth/login
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "Password1!"
}

###

### Login User - Invalid Email Format (should fail validation)
POST http://localhost:5000/auth/login
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "Password1!"
}

###

### Login User - Missing Password (should fail validation)
POST http://localhost:5000/auth/login
Content-Type: application/json

{
  "email": "john.doe@example.com"
}

###

### Login User - Missing Email (should fail validation)
POST http://localhost:5000/auth/login
Content-Type: application/json

{
  "password": "Password1!"
}

###

### Login User - Empty Body (should fail validation)
POST http://localhost:5000/auth/login
Content-Type: application/json

{}

###

