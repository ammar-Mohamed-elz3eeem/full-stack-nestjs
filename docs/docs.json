{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Your Docs",
  "colors": {
    "primary": "#ff0000"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "square-terminal",
        "pages": ["introduction", "quickstart", "authentication"]
      },
      {
        "tab": "API",
        "icon": "square-terminal",
        "openapi": "openapi.json"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required",
      "prefill": true
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com",
        "icon": "github"
      }
    ]
  }
}
